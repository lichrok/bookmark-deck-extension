{
  "manifest_version": 3,
  "name": "Home-tab",
  "version": "1.0.0",
  "description": "A minimal new tab page that displays bookmarks from your Home-tab folder.",
  "permissions": ["bookmarks", "storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "incognito": "split"
}
